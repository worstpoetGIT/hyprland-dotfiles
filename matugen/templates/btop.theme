# Auto-generated by matugen — do not edit manually
# Structural colors follow the system Material You palette; usage/temp
# gradients keep green->amber->red danger semantics but pull from theme
# roles (secondary=calm, tertiary=mid, error=danger) instead of hardcoded
# red/green so they still read as "this system's colors".

theme[main_bg]="#000000"
theme[main_fg]="{{colors.on_surface.default.hex}}"
